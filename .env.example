# --- server ---
PORT=8080
# Hard timeout per upstream call.
# RPC_TIMEOUT_MS=8000
# HTTP_TIMEOUT_MS=10000
# PRICE_TIMEOUT_MS=7000

# Soft deadlines: stop waiting for stragglers once at least one source has
# answered. These, not the hard timeouts, set your typical response latency.
# RPC_SOFT_DEADLINE_MS=1200
# PRICE_SOFT_DEADLINE_MS=1500

# --- RPC (latency feeds your Canonical Score — set this) ---
# One key covers every chain: the Alchemy URL is built per chain automatically
# and used as the PRIMARY rpc, with public nodes kept as fallbacks.
ALCHEMY_API_KEY=

# Per-chain override; wins over Alchemy + public list. Comma-separated.
# RPC_ETHEREUM=
# RPC_BASE=
# RPC_POLYGON=
# RPC_BSC=
# RPC_ARBITRUM=
# RPC_OPTIMISM=
# RPC_AVALANCHE=
# RPC_SCROLL=
# RPC_LINEA=
# RPC_GNOSIS=

# --- optional data sources ---
# Etherscan V2 key: enables token holder counts on BSC/Avalanche and acts as a
# fallback everywhere Blockscout fails. The free tier is enough, and Blockscout
# times out often enough that TOKEN_HOLDER_COUNT is unreliable without this.
# Get one at https://etherscan.io/apis
ETHERSCAN_API_KEY=

# --- cache tuning (defaults are sane) ---
# CACHE_DISABLED=0
# CACHE_MAX_ENTRIES=5000
# PRICE_CACHE_MS=5000        # prices: 5s
# HOLDERS_CACHE_MS=300000    # holder counts: 5min
# TVL_CACHE_MS=300000        # TVL: 5min
# TX_CACHE_MS=3600000        # confirmed txs are immutable: 1h
# gas/balance TTL is per-chain block time (see src/chains.js)

# --- registration (scripts/register.js) ---
# PRIVATE_KEY=0x...          # wallet with Base Sepolia ETH for gas
# YAML_URL=https://raw.githubusercontent.com/you/repo/main/telegraph-miner.yaml
# FEE_ADDRESS=0x...          # payout address (defaults to PRIVATE_KEY's address)
# MIN_PRICE=10000            # $0.01 in USDC 6dp units (protocol minimum)
# DIAMOND_ADDR=0x122396E8602BEed349434AA6E83123E7dD97F5A0
