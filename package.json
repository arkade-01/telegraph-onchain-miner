{
  "name": "telegraph-onchain-miner",
  "version": "2.0.0",
  "description": "Telegraph Protocol miner: 6 canonical on-chain intents across 10 EVM chains, answering both explicit params and natural-language questions",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "smoke": "bash scripts/smoke.sh",
    "hash:yaml": "node scripts/hash-yaml.js",
    "register": "node --env-file-if-exists=.env scripts/register.js",
    "update": "node --env-file-if-exists=.env scripts/update.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "viem": "^2.21.0"
  },
  "license": "MIT"
}
